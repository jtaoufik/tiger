{
  "name": "tiger-api-client",
  "version": "0.2.0",
  "description": "An offline, git-friendly API client with a frosted-glass UI. Collections are plain-text .tiger files.",
  "author": "jtaoufik",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "bin": {
    "tiger-mcp": "out/mcp/server.mjs"
  },
  "homepage": "https://github.com/jtaoufik/tiger",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtaoufik/tiger.git"
  },
  "keywords": [
    "api-client",
    "http",
    "rest",
    "electron",
    "bruno",
    "offline",
    "git-friendly"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --packages=external --outfile=out/mcp/server.mjs",
    "mcp": "node out/mcp/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && npm run build:mcp && electron-builder",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^3.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "firebase": "^12.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "build": {
    "appId": "com.taoufikjabbari.tiger",
    "productName": "Tiger",
    "artifactName": "Tiger-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "out/mcp/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Tiger-Setup-${version}-windows-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Tiger-Portable-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
