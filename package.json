{
  "name": "tiger-api-client",
  "version": "0.9.0",
  "description": "An offline, git-friendly API client with a frosted-glass UI. Collections are plain-text .tiger files.",
  "author": {
    "name": "Taoufik Jabbari",
    "email": "jtaoufik@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "bin": {
    "tiger-mcp": "out/mcp/server.mjs"
  },
  "homepage": "https://github.com/jtaoufik/tiger",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtaoufik/tiger.git"
  },
  "keywords": [
    "api-client",
    "http",
    "rest",
    "electron",
    "bruno",
    "offline",
    "git-friendly"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --outfile=out/mcp/server.mjs",
    "mcp": "node out/mcp/server.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:mcp && playwright test",
    "test:contrast": "npm run build && npm run build:mcp && TIGER_CONTRAST_SWEEP=1 AUDIT_STRICT=1 playwright test e2e/contrast",
    "i18n:check": "node scripts/i18n-check.mjs",
    "site:check": "node scripts/check-site.mjs",
    "package": "npm run build && npm run build:mcp && electron-builder",
    "analyze": "electron-vite build",
    "perf:startup": "node scripts/perf-startup.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0",
    "firebase": "^13.2.0",
    "lucide-react": "^1.68.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "com.taoufikjabbari.tiger",
    "productName": "Tiger",
    "artifactName": "Tiger-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "build/icon.png",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "out/mcp/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Tiger-Portable-${version}-windows-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Tiger-Setup-${version}-windows-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tiger",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Tiger-Portable-${version}-windows-${arch}.${ext}"
    },
    "appx": {
      "artifactName": "Tiger-${version}-windows-${arch}.${ext}",
      "displayName": "Tiger API Client",
      "backgroundColor": "#ff6a1a",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": true
    },
    "appImage": {
      "artifactName": "Tiger-${version}-linux-x64.AppImage"
    },
    "deb": {
      "artifactName": "Tiger-${version}-linux-amd64.deb"
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "Tiger-${version}-linux-${arch}.${ext}",
      "category": "Development",
      "maintainer": "Taoufik Jabbari <jtaoufik@users.noreply.github.com>",
      "synopsis": "Offline, git-friendly API client with a frosted-glass UI",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jtaoufik",
        "repo": "tiger"
      }
    ],
    "afterSign": "build/notarize.cjs"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
