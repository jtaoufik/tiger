meta {
  name: Get user
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users/:id/orders/:orderId
  body: none
  auth: inherit
}

params:query {
  expand: profile
  ~debug: 1
}

params:path {
  id: {{userId}}
  orderId:
}

headers {
  X-Trace: {{$guid}}
}

vars:pre-request {
  localOnly: 1
}

script:post-response {
  bru.setVar("lastUserId", res.body.id);
}

tests {
  test("returns the user", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body).to.have.property("id");
  });
}

docs {
  Fetches one user.
}
